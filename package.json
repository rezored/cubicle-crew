{
  "name": "cubicle-crew",
  "version": "2.22.2",
  "type": "module",
  "bin": {
    "cubicle-crew": "bin/cubicle-crew.js"
  },
  "files": [
    "bin/",
    "server.js",
    "wallet.js",
    "weather.js",
    "update.js",
    "external.js",
    "stats.js",
    "focus.js",
    "providers.js",
    "permissions.js",
    "lan.js",
    "folders.js",
    "public/",
    "!public/sprites/*.psd"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "debug": "node server.js --debug",
    "desktop": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "predist": "node -e \"fs.rmSync('release', { recursive: true, force: true })\"",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "description": "Your Claude Code agents, living in a tiny pixel-art office",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini-cli",
    "antigravity",
    "opencode",
    "ai-agents",
    "pixel-art",
    "dashboard",
    "monitor"
  ],
  "author": "Kalin Dimitrov",
  "license": "MIT",
  "build": {
    "appId": "com.pixeloffice.desktop",
    "productName": "Cubicle Crew",
    "copyright": "Copyright © 2026 Kalin Dimitrov",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "wallet.js",
      "weather.js",
      "update.js",
      "external.js",
      "stats.js",
      "focus.js",
      "providers.js",
      "permissions.js",
      "lan.js",
      "folders.js",
      "electron/**",
      "public/**",
      "!public/sprites/*.psd"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cubicle Crew",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CubicleCrew-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSHumanReadableCopyright": "Copyright © 2026 Kalin Dimitrov"
      },
      "artifactName": "CubicleCrew-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Cubicle Crew ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "Development",
      "executableName": "cubicle-crew",
      "synopsis": "Your Claude Code agents in a tiny pixel-art office",
      "artifactName": "CubicleCrew-${version}-linux.${ext}"
    }
  },
  "homepage": "https://github.com/rezored/cubicle-crew",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezored/cubicle-crew.git"
  }
}
