{
  "name": "cubicle-crew",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "debug": "node server.js --debug",
    "desktop": "electron .",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js",
  "description": "Your Claude Code agents, living in a tiny pixel-art office",
  "author": "Kalin Dimitrov",
  "license": "MIT",
  "build": {
    "appId": "com.pixeloffice.desktop",
    "productName": "Cubicle Crew",
    "copyright": "Copyright © 2026 Kalin Dimitrov",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "server.js",
      "wallet.js",
      "electron/**",
      "public/**",
      "!public/sprites/*.psd"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cubicle Crew",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CubicleCrew-Setup-${version}.exe"
    }
  },
  "homepage": "https://github.com/rezored/cubicle-crew",
  "repository": {
    "type": "git",
    "url": "https://github.com/rezored/cubicle-crew.git"
  }
}
